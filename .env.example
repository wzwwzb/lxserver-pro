# 复制为 .env 后填写。密码保持单引号包裹，可避免 $、# 等字符被解释。
# .env 已在 .gitignore 和 .dockerignore 中排除。

# 必填：三个独立的密码。首次部署会创建名为 user1 的同步用户。
ADMIN_PASSWORD=''
WEBPLAYER_PASSWORD=''
LX_USER_user1=''

# 宿主机监听地址及端口。局域网直连使用 0.0.0.0；宿主机反向代理使用 127.0.0.1。
HOST_IP=0.0.0.0
HOST_PORT=9527

# 外部音乐目录：左侧宿主机目录映射到容器中的独立子目录。
# 默认使用项目内 music 目录；可换成已存在的宿主机绝对路径。
LOCAL_LIBRARY_HOST_PATH=./music
LOCAL_LIBRARY_CONTAINER_PATH=/library/music

SERVER_NAME='我的 LX 同步服务'
ENABLE_WEBPLAYER_AUTH=true
TZ=Asia/Shanghai

# 只有 docker-compose.yml 的 environment 中引用的变量才会传入容器。
# WebDAV、音源和其他业务设置可在部署后通过 /admin 管理。
